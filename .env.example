# === Autenticación del Administrador ===
# En local se generan con: node scripts/setup-admin.mjs
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=

# === Opciones de Base de Datos para Persistencia en Vercel (Elige UNA) ===

# Opción 1: Turso / libSQL (Recomendado - SQLite en la nube gratuito)
# TURSO_DATABASE_URL=libsql://tu-base-datos.turso.io
# TURSO_AUTH_TOKEN=tu-token-aqui

# Opción 2: PostgreSQL / Supabase / Neon / Vercel Postgres
# DATABASE_URL=postgres://usuario:password@host/database?sslmode=require
# o POSTGRES_URL=postgres://...

# Opción 3: Vercel KV / Upstash Redis (1-Click en pestaña Storage de Vercel)
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
